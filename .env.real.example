# Copy to .env.real (gitignored) for `make real`.

# Maps the placeholders the repo uses to the labels your own dashboard should
# show. JSON, one line.
DISPLAY_NAMES='{"Person A": "Name", "Person B": "Name", "Card A": "Bank", "Card B": "Bank", "Card C": "Bank"}'

# Goals (see the vars in dbt/dbt_project.yml). Leave FI_MONTHLY_SPENDING empty
# to use the last 12 months' average spending.
FI_TARGET_MONTH=2050-01-01
FI_MONTHLY_SPENDING=
NEW_MONEY_GOAL_FROM=2026-01-01
NEW_MONEY_GOAL_START=2500
NEW_MONEY_GOAL_STEP=500
