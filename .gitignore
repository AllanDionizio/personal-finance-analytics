# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Secrets — never commit
.env
.env.*
!.env.example
*.json.key
service-account*.json
# dbt/profiles.yml IS committed: it only reads credentials from env vars

# Data — real data never goes to git; synthetic samples are generated, not committed
data/raw/*
!data/raw/.gitkeep
data/processed/
data/synthetic/
*.duckdb
*.duckdb.wal
*.parquet
*.xlsx
*.csv
!dbt/seeds/*.csv

# dbt
dbt/target/
dbt/dbt_packages/
dbt/logs/
dbt/.user.yml
logs/

# Evidence
dashboards/.evidence/
dashboards/build/
# Assembled Pages site (make site)
site/
node_modules/

# Claude Code (local settings only)
.claude/settings.local.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
