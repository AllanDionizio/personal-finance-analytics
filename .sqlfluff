[sqlfluff]
dialect = duckdb
templater = dbt
max_line_length = 100
exclude_rules = ST06

[sqlfluff:templater:dbt]
project_dir = dbt
profiles_dir = dbt

[sqlfluff:indentation]
tab_space_size = 4

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = lower

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = lower

[sqlfluff:rules:references.keywords]
# Column names of the data model: who earned a credit, and dim_date's parts
ignore_words = owner,year,quarter,month
